# Generated by `llm-bonsai setup secrets` (run by `make up`). Dev-only random values.
LITELLM_MASTER_KEY='sk-...'
LITELLM_DB_PASSWORD='...'

LANGFUSE_SALT='...'
LANGFUSE_ENCRYPTION_KEY='<64 hex chars>'
LANGFUSE_NEXTAUTH_SECRET='...'
LANGFUSE_DB_PASSWORD='...'
LANGFUSE_CLICKHOUSE_PASSWORD='...'
LANGFUSE_REDIS_PASSWORD='...'
LANGFUSE_S3_PASSWORD='...'
# Project API keys (created by Langfuse's headless init; read by the SDK and LiteLLM)
LANGFUSE_PUBLIC_KEY='pk-lf-...'
LANGFUSE_SECRET_KEY='sk-lf-...'
# Langfuse UI login
LANGFUSE_INIT_USER_EMAIL='admin@example.com'
LANGFUSE_INIT_USER_PASSWORD='...'

# Written by `llm-bonsai setup teams` (`make bootstrap`).
LITELLM_KEY_PAYMENTS_AI='sk-...'
LITELLM_KEY_SUPPORT_BOT='sk-...'

# Written by `llm-bonsai setup prometheus`: Prometheus's scrape key, limited to /metrics.
LITELLM_KEY_PROMETHEUS='sk-...'
